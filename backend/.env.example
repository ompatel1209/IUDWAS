PORT=3001
NODE_ENV=development
JWT_SECRET=your_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_secure_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
DATABASE_PATH=./data/iudwas.db
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_SIZE_BYTES=52428800
SEED_DEFAULT_PASSWORD=Password@123

# Rate Limiting Configuration (Configurable Thresholds)
# 1. Auth Tier (Strict limits + Exponential Backoff)
RATE_AUTH_IP_WINDOW_MS=900000
RATE_AUTH_IP_MAX=20
RATE_AUTH_ACCOUNT_FREE_ATTEMPTS=5
RATE_AUTH_BACKOFF_BASE_SECONDS=2
RATE_AUTH_BACKOFF_MAX_SECONDS=1800
RATE_AUTH_ACCOUNT_RESET_WINDOW_MS=3600000

# 2. Public Endpoints Tier (Moderate limits)
RATE_PUBLIC_WINDOW_MS=900000
RATE_PUBLIC_MAX=120

# 3. Authenticated User Actions Tier (Looser limits)
RATE_AUTH_USER_IP_WINDOW_MS=900000
RATE_AUTH_USER_IP_MAX=600
RATE_AUTH_USER_USER_WINDOW_MS=900000
RATE_AUTH_USER_USER_MAX=500

# 4. Upload Tier (Per-user hourly cap)
RATE_UPLOAD_WINDOW_MS=3600000
RATE_UPLOAD_MAX=30

# 5. AI / OCR Tier (Per-user hourly cap)
RATE_AI_WINDOW_MS=3600000
RATE_AI_MAX=60
